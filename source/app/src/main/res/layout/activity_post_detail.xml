<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="a"
            type="itz.next_step.android.ui.main.postDetail.PostDetailActivity"/>
        <variable
            name="vm"
            type="itz.next_step.android.ui.main.postDetail.PostDetailViewModel"/>

        <import type="android.view.View"/>
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_app">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_300sdp"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_detail_post_top">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_240sdp"
                app:layout_scrollFlags="scroll"
                android:animateLayoutChanges="true"
                app:contentScrim="@color/bg_green">


                <FrameLayout
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/btnBack"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:src="@drawable/ic_back"
                            android:background="@drawable/bg_white_round"
                            android:layout_margin="@dimen/_10sdp"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_margin="@dimen/_10sdp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/iconRight"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:src="@drawable/ic_more"
                            android:background="@drawable/bg_white_round"
                            android:layout_margin="@dimen/_10sdp"/>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:id="@+id/infoBox"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_180sdp"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_marginTop="@dimen/_60sdp"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:background="@drawable/bg_white_stroke_gray"
                            android:elevation="4dp"
                            android:orientation="vertical"
                            tools:layout_editor_absoluteX="72dp">


                            <TextView
                                android:id="@+id/tvJobPosition"
                                style="@style/Text_16_Bold_Black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_50sdp"
                                android:text="Vị trí công việc"
                                android:textColor="@color/text_black" />

                            <TextView
                                android:id="@+id/tvCompanyName"
                                style="@style/Text_12_Bold_Black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:text="TÊN CÔNG TY"
                                android:textAllCaps="true"
                                android:textColor="@color/text_gray" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:layout_marginEnd="@dimen/_10sdp"
                                android:orientation="horizontal"
                                android:weightSum="3">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="@dimen/_5sdp">

                                    <ImageView
                                        android:layout_width="@dimen/_30sdp"
                                        android:layout_height="@dimen/_30sdp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_salary" />

                                    <TextView
                                        style="@style/Text_10_Bold_Edit"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="Mức lương"
                                        android:textColor="@color/text_gray" />

                                    <TextView
                                        android:id="@+id/tvSalary"
                                        style="@style/Text_12_Bold_Edit"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="15 - 20 triệu"
                                        android:textColor="@color/text_green" />
                                </LinearLayout>

                                <View
                                    android:layout_width="@dimen/_1sdp"
                                    android:layout_height="match_parent"
                                    android:background="@color/line" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="@dimen/_5sdp">

                                    <ImageView
                                        android:layout_width="@dimen/_30sdp"
                                        android:layout_height="@dimen/_30sdp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_address" />

                                    <TextView
                                        style="@style/Text_10_Bold_Edit"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="Địa điểm"
                                        android:textColor="@color/text_gray" />

                                    <TextView
                                        style="@style/Text_12_Bold_Edit"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="Hồ Chí Minh"
                                        android:textColor="@color/text_green" />
                                </LinearLayout>

                                <View
                                    android:layout_width="@dimen/_1sdp"
                                    android:layout_height="match_parent"
                                    android:background="@color/line" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="@dimen/_5sdp">

                                    <ImageView
                                        android:layout_width="@dimen/_30sdp"
                                        android:layout_height="@dimen/_30sdp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_exp" />

                                    <TextView
                                        style="@style/Text_10_Bold_Edit"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="Kinh nghiệm"
                                        android:textColor="@color/text_gray" />

                                    <TextView
                                        android:id="@+id/tvExp"
                                        style="@style/Text_12_Bold_Edit"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="1 năm"
                                        android:textColor="@color/text_green" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/logo"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_80sdp"
                            android:layout_gravity="center|top"
                            android:layout_marginTop="@dimen/_25sdp"
                            android:background="@drawable/bg_white_stroke_gray"
                            android:elevation="8dp"
                            android:padding="@dimen/_5sdp"
                            android:src="@drawable/ic_home" />
                    </FrameLayout>
                </FrameLayout>


            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_collapseMode="pin"
                app:layout_scrollFlags="enterAlways">
                <LinearLayout
                    android:id="@+id/toolbarCollapse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:padding="@dimen/_5sdp"
                    android:background="@color/bg_app">
                    <ImageView
                        android:id="@+id/btnBackCollapsed"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/ic_back"/>

                    <TextView
                        android:id="@+id/tvJobPositionCollapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:text="Vị trí công việc"
                        android:gravity="center_horizontal"
                        style="@style/Text_16_Bold_Black"/>

                    <ImageView
                        android:id="@+id/btnMoreCollapsed"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/ic_more"/>
                </LinearLayout>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tabMode="scrollable"
                    app:tabTextColor="@color/text_gray"
                    app:tabSelectedTextColor="@color/text_green"
                    app:tabTextAppearance="@style/Text_12_Normal_Black"/>
            </LinearLayout>


        </com.google.android.material.appbar.AppBarLayout>


        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_app"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:background="@color/bg_app"
            android:orientation="horizontal"
            android:layout_gravity="bottom">
            <ImageButton
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:src="@drawable/ic_love"
                android:background="@drawable/bg_green_stroke_green"
                android:scaleType="centerInside"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_10sdp"
                android:padding="@dimen/_6sdp"/>
            <Button
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:background="@drawable/bg_btn_radius_8"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:text="Ứng tuyển ngay"
                android:textAllCaps="false"
                style="@style/Text_14_Normal_Black"
                android:layout_margin="@dimen/_10sdp"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout></layout>