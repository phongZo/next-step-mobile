<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="a"
            type="itz.next_step.android.ui.main.postDetail.PostDetailActivity"/>
        <variable
            name="vm"
            type="itz.next_step.android.ui.main.postDetail.PostDetailViewModel"/>

        <import type="android.view.View"/>
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_app">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_300sdp"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_detail_post_top">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_240sdp"
                app:layout_scrollFlags="scroll"
                android:animateLayoutChanges="true"
                app:contentScrim="@color/bg_green">


                <FrameLayout
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/btnBack"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:src="@drawable/ic_back"
                            android:background="@drawable/bg_white_round"
                            android:layout_margin="@dimen/_10sdp"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_margin="@dimen/_10sdp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/iconRight"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:src="@drawable/ic_more"
                            android:background="@drawable/bg_white_round"
                            android:layout_margin="@dimen/_10sdp"/>
                    </LinearLayout>

                    <include
                        layout="@layout/layout_post_detail"
                        android:id="@+id/postDetailLayout"
                        app:vm="@{vm}"/>
                </FrameLayout>


            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_collapseMode="pin"
                app:layout_scrollFlags="enterAlways">
                <LinearLayout
                    android:id="@+id/toolbarCollapse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:padding="@dimen/_5sdp"
                    android:background="@color/bg_app">
                    <ImageView
                        android:id="@+id/btnBackCollapsed"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/ic_back"/>

                    <TextView
                        android:id="@+id/tvJobPositionCollapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:text="Vị trí công việc"
                        android:gravity="center_vertical"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:maxLines="2"
                        style="@style/Text_14_Bold_Black"/>

                    <ImageView
                        android:id="@+id/btnMoreCollapsed"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/ic_more"/>
                </LinearLayout>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tabMode="scrollable"
                    app:tabTextColor="@color/text_gray"
                    app:tabSelectedTextColor="@color/text_green"
                    app:tabTextAppearance="@style/Text_12_Normal_Black"/>
            </LinearLayout>


        </com.google.android.material.appbar.AppBarLayout>


        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_app"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_50sdp"/>

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:background="@color/bg_app"
            android:orientation="horizontal"
            android:layout_gravity="bottom">
            <ImageButton
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:src="@drawable/ic_love"
                android:background="@drawable/bg_green_stroke_green"
                android:scaleType="centerInside"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_10sdp"
                android:padding="@dimen/_6sdp"/>
            <Button
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:background="@drawable/bg_btn_radius_8"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:text="Ứng tuyển ngay"
                android:textAllCaps="false"
                style="@style/Text_14_Normal_Black"
                android:layout_margin="@dimen/_10sdp"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout></layout>